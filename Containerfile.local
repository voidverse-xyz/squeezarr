# Local/dev image: single stage, unhardened. Same shape as production — the Express backend
# serves the prebuilt Next.js UI — but built in one stage for a fast `compose up`.
# Pinned to a bookworm base so the MongoDB 7.0 apt repo resolves directly.
FROM node:22-bookworm

# ffmpeg for transcoding; mongodb-org-server so the backend can spin up a local mongod when
# HOST_IP is empty.
RUN apt-get update \
    && apt-get install -y ca-certificates curl gnupg ffmpeg \
    && curl -fsSL https://www.mongodb.org/static/pgp/server-7.0.asc \
        | gpg -o /usr/share/keyrings/mongodb-server-7.0.gpg --dearmor \
    && echo "deb [ signed-by=/usr/share/keyrings/mongodb-server-7.0.gpg ] https://repo.mongodb.org/apt/debian bookworm/mongodb-org/7.0 main" \
        > /etc/apt/sources.list.d/mongodb-org-7.0.list \
    && apt-get update \
    && apt-get install -y mongodb-org-server \
    && rm -rf /var/lib/apt/lists/*

ENV NODE_ENV="production" \
    CONFIG_DIR="/config" \
    NEXT_TELEMETRY_DISABLED=1 \
    FRONTEND_DIR=/server/frontend/out

WORKDIR /server

# Workspace manifests first for layer caching, then install all workspaces including dev tooling.
COPY ./package.json ./package-lock.json ./
COPY ./.prettierrc ./.prettierignore ./
COPY shared/package.json ./shared/
COPY backend/package.json ./backend/
COPY frontend/package.json ./frontend/
RUN npm install --include=dev

# Sources, then build the static UI.
COPY shared ./shared
COPY backend ./backend
COPY frontend ./frontend
RUN npm run build -w frontend \
    && mkdir -p /config /data \
    && chown node:node /config /data

# Match production uid/gid so development cannot leave root-owned Mongo state in the named
# config volume. Bind-mounted media permissions remain the host administrator's responsibility.
USER node

CMD ["node", "/server/backend/server.js"]

EXPOSE 3000
